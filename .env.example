# Copy to .env only if the instructor enables live access.
# Python does NOT load .env automatically; export variables in your shell or
# configure your editor to load it. Never commit .env or a real API key.
# All offline exercises work without loading this file or supplying credentials.
WORKSHOP_MODE=offline

# Common live opt-in: both values are required for a live client.
# WORKSHOP_MODE=live
# WORKSHOP_LIVE_ACK=approved-paid-calls
# Use the instructor's HTTPS base ending in /v1, NOT /v1/responses.
# WORKSHOP_BASE_URL=https://YOUR-APPROVED-GATEWAY/v1
# Use an individual restricted inference key, never the LiteLLM master key.
# WORKSHOP_API_KEY=

# Session 1: model and request settings come from these environment variables.
# WORKSHOP_MODEL=YOUR-VERIFIED-VLM-ALIAS
# Leave unset unless the instructor confirms reasoning support for this alias.
# WORKSHOP_REASONING_EFFORT=low
# Includes reasoning + visible output; range 1..8192; default 4096.
# WORKSHOP_MAX_OUTPUT_TOKENS=4096

# Session 1: examples only; use the instructor's verified values for live work.
# SPEND_USD is a conservative allowance for ONE invocation, not a workshop-wide
# allowance or actual metered cost. MAX_CALL_USD must bound the worst-case cost
# of each model request, including PDF reads, input size and output tokens.
# WORKSHOP_SPEND_USD=0.25
# WORKSHOP_MAX_CALL_USD=0.05

# Session 2 (on starter/session-2):
# --mode scripted is explicitly offline, regardless of these live settings.
# --mode live ALSO requires the common live opt-in, base URL and scoped key.
# The selected --config JSON supplies each variant's model, reasoning_effort,
# max_output_tokens, max_call_usd and run_allowance_usd; it overrides the matching
# environment settings above. WORKSHOP_SPEND_USD is not used by that runner.
# Each case/variant execution gets its configured run allowance; the four-run
# experiment has no shared metered budget. Gateway key limits remain separate.
# No working endpoint, model selection, credential or live approval is shipped.

# Session 3 demo/compare/context/export commands are offline and do not read live keys.
# They provide no live execution mode. Reading existing live artifacts makes
# no new requests; fresh model experiments still require separate approval.
